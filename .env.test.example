# Connection info for the ephemeral test Postgres started by:
#   docker compose -f docker-compose.test.yml up -d
# Values here match docker-compose.test.yml's fixed test credentials —
# there is nothing sensitive to protect, but .env.test is still gitignored
# for consistency with .env.
POSTGRES_TEST_PORT=55432
POSTGRES_HOST=localhost
POSTGRES_PORT=55432
POSTGRES_DB=daybook_test
POSTGRES_USER=postgres
POSTGRES_PASSWORD=test
