# App
APP_PORT=7777
APP_PASSWORD=changeme
SESSION_SECRET=changeme-long-random-string
SESSION_TTL_HOURS=168

# TLS (optional, native via Bun.serve)
TLS_ENABLED=false
#TLS_CERT_PATH=/path/to/cert.pem
#TLS_KEY_PATH=/path/to/key.pem

# Postgres (index only, always rebuildable)
POSTGRES_DB=daybook
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
# Host path for the postgres data volume — absolute path, no ~
POSTGRES_DATA_DIR=/absolute/path/to/postgres/app-daybook

# pgadmin (only used with: docker compose --profile debug up)
#PGADMIN_DEFAULT_EMAIL=admin@example.com
#PGADMIN_DEFAULT_PASSWORD=changeme

# Used for "today" and server-side timestamps
TZ=Europe/Madrid
